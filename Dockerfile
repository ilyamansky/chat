# Используйте официальный образ Node.js
FROM node:20.9.0-alpine

# Установите рабочую директорию
WORKDIR /app

# Скопируйте только package.json и package-lock.json для оптимизации кэша
COPY package*.json ./

# Установите зависимости
RUN npm install

# Скопируйте остальные файлы в контейнер
COPY . .

# Соберите приложение
RUN npm run build




# Укажите порт, который будет использоваться приложением
EXPOSE 3000

# Укажите команду для запуска приложения
CMD ["npm", "start"]